    "panel-3": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "ffo7dczvo2328c"
                    },
                    "group": "grafana-clickhouse-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorType": "sql",
                      "format": 0,
                      "meta": {
                        "builderOptions": {
                          "columns": [],
                          "database": "",
                          "limit": 1000,
                          "mode": "list",
                          "queryType": "table",
                          "table": ""
                        }
                      },
                      "pluginVersion": "4.17.0",
                      "queryType": "timeseries",
                      "rawSql": "SELECT\n    time,\n    metric,\n    value\nFROM\n(\n    SELECT\n        predict_time AS time,\n        concat('value ', model_name) AS metric,\n        predicted AS value\n    FROM bigdata.predictions\n    WHERE device_id IN (${device_id:singlequote})\n      AND model_name IN (${model_name:singlequote})\n      AND $__timeFilter(predict_time)\n\n    UNION ALL\n\n    SELECT\n        predict_time AS time,\n        'value actual' AS metric,\n        actual AS value\n    FROM bigdata.predictions\n    WHERE device_id IN (${device_id:singlequote})\n      AND model_name IN (${model_name:singlequote})\n      AND $__timeFilter(predict_time)\n)\nORDER BY time ASC"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "",
