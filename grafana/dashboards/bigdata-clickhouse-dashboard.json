              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "ffo7dczvo2328c"
                    },
                    "group": "grafana-clickhouse-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorType": "sql",
                      "format": 0,
                      "meta": {
                        "builderOptions": {
                          "columns": [],
                          "database": "",
                          "limit": 1000,
                          "mode": "list",
                          "queryType": "table",
                          "table": ""
                        }
                      },
                      "pluginVersion": "4.17.0",
                      "queryType": "timeseries",
                      "rawSql": "SELECT\n    toStartOfHour(event_time) AS time,\n    concat('value ', device_id) AS metric,\n    avg(temperature) AS value\nFROM bigdata.sensor_readings\nWHERE device_id IN (${device_id:singlequote})\n  AND $__timeFilter(event_time)\nGROUP BY time, device_id\nORDER BY time"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
