                      "pluginVersion": "4.17.0",
                      "queryType": "table",
                      "rawSql": "SELECT\n    event_time AS time,\n    device_id,\n    round(temperature, 1) AS temperature,\n    round(z_score, 2) AS z_score\nFROM bigdata.anomalies\nORDER BY event_time DESC\nLIMIT 100"
